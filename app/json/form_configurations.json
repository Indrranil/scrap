    "users": {
        "name": "User Management Form",
        "description": "Form for creating/editing users",
        "fields": [
            {
                "name": "username",
                "type": "text",
                "required": true,
                "property_type": "user_name"
            },
            {
                "name": "firstName",
                "type": "text",
                "required": true,
                "property_type": "first_name"
            },
            {
                "name": "lastName",
                "type": "text",
                "required": true,
                "property_type": "last_name"
            },
            {
                "name": "email",
                "type": "email",
                "required": false,
                "property_type": "email_address"
            },
            {
                "name": "Role",
                "type": "select",
                "options": ["admin", "user"],
                "required": false,
                "property_type": "role"
            },
            {
                "name": "Designation",
                "type": "select",
                "options": ["LQC", "SHIFT EXECUTIVE", "QUALITY EXECUTIVE"],
                "required": false,
                "property_type": "designation"
            }
        ]
    },
