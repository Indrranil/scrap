# Copy to .env in project root and fill in values

# ── Database (use creds from your server) ──
MYSQL_USER=digiscrapyard
MYSQL_PASSWORD=changeme
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=digiscrapyard

# ── Auth ──
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRE_HOURS=24

# ── API ──
API_PORT=8000

# ── Do not enable on production ──
TESTING=0

# ── Seed script defaults (first deploy) ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=System Admin

# ── GSO approval ──
GSO_APPROVAL_ENABLED=true
GSO_AUTO_APPROVE_HOURS=2

